# Local settings for t2pbi. Copy this file to `.env` (gitignored) and fill in what you need.
# Real environment variables take precedence over `.env`. Empty values mean "use the default".
# Never commit `.env`: it holds secrets.

# --- Azure OpenAI ------------------------------------------------------------------------------
# Used by the LLM steps (DAX translation, visual router, visual fidelity judge, refinement agent).
# Endpoint: Azure portal > your Azure OpenAI resource > Keys and Endpoint,
#   e.g. https://my-resource.openai.azure.com/
T2PBI_AZURE_OPENAI_ENDPOINT=
# Your deployment's NAME (Foundry portal > Deployments), not the model name. Default: gpt-4o.
T2PBI_AZURE_OPENAI_DEPLOYMENT=
# Default 2024-08-01-preview works for gpt-4o; newer models may need a newer version (the
# Responses API below needs 2025-03-01-preview or later).
T2PBI_AZURE_OPENAI_API_VERSION=
# Leave empty to sign in with your Azure identity (`az login`; needs the "Cognitive Services
# OpenAI User" role on the resource). Set it only for key-based auth.
T2PBI_AZURE_OPENAI_API_KEY=
# Default 0 (most repeatable). Reasoning models (o-series, gpt-5 family) only accept their own
# default and reject 0 with a 400 error: set `default` to send no temperature at all.
T2PBI_AZURE_OPENAI_TEMPERATURE=
# true = use the Responses API instead of Chat Completions. Reasoning models (gpt-5 family) refuse
# tool calls on Chat Completions ("Function tools with reasoning_effort are not supported"), so the
# refinement agent (--refine) needs this with them. Default false.
T2PBI_AZURE_OPENAI_RESPONSES_API=

# --- Power BI Desktop (rendering, DAX against loaded data) ----------------------------------------
# Optional: t2pbi finds both the classic and the Microsoft Store install by itself. Set this only
# to force a specific PBIDesktop.exe. (Store paths contain the version, so a hard-coded one breaks
# when the Store updates Desktop.)
PBI_DESKTOP_PATH=

# --- Power BI Authoring MCP server ---------------------------------------------------------------
# Setting this to true means YOU accept its EULA: https://go.microsoft.com/fwlink/?LinkId=2381247
# t2pbi never accepts it on your behalf.
PBI_MODELING_MCP_ACCEPT_EULA=

# --- Tracing (optional) ---------------------------------------------------------------------------
# true = send every run's steps, model calls and tool calls to a local Arize Phoenix, browsable
# in its web UI. Start it first with `python scripts/phoenix_server.py` (its telemetry off).
# Needs `pip install -e ".[trace]"`. Traces hold the prompts, report JSON and screenshots (client
# data for a client workbook): keep the endpoint on your own machine. Default false.
T2PBI_PHOENIX=
# Default http://localhost:6006.
T2PBI_PHOENIX_ENDPOINT=
# Default t2pbi.
T2PBI_PHOENIX_PROJECT=
