# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local secrets / env
.env
*.local

# Generated output
/out/
*.pbip.tmp/

# Pinned external tools: installed with `npm ci` in tools/, built with `dotnet publish`
tools/node_modules/
tools/**/bin/
tools/**/obj/

# Tableau autosave / recovery files written next to an open workbook
~*.twbr

# Editor
.vscode/

# Third-party workbooks (Tableau Public): kept local, never pushed to the public repo
/samples/local/

# Tableau Hyper's process log: lists local file paths
hyperd*.log
